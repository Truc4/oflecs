+// filepath.join returns an allocator error too since the core:os rework; with the arena allocators used
+// here a failure means the arena is exhausted, which is fatal anyway.
+path_join :: proc(elems: []string) -> string {
+	joined, err := filepath.join(elems)
+	log.ensuref(err == nil, "Failed joining path %v: %v", elems, err)
+	return joined
+}
